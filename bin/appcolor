#!/usr/bin/env -S python3 -I
"""appcolor: app-coloured borders and title bars on floating Hyprland windows.

  appcolor toggle|on|off     turn the feature on or off (persists)
  appcolor status            print on/off; exit 0 when on
  appcolor resolve <key>...  derive colours for app keys (called by Hyprland)
  appcolor rebuild           re-derive every known app's colours (run on theme change)
  appcolor list              show the cached palette

App keys come from hypr/appcolor.lua:
  claude          a terminal running Claude Code
  web:<stem>      a Chrome web app, e.g. web:app.hubspot.com__
  <class>         any other app, by lower-cased window class

Each app gets one colour from its icon: a one-colour brand keeps its own,
a multi-colour logo takes whichever of its colours sits furthest from other
apps, and a black-and-white icon takes an Omarchy theme colour. When an app
has no local icon, its icon is downloaded once from the Dashboard Icons
collection and cached; turn that off in ~/.config/appcolor/config.json:
  { "downloadIcons": false }
Set any app's colour in ~/.config/appcolor/overrides.json:
  { "web:app.hubspot.com__": ["#ff7a59"] }
"""

import colorsys
import math
import configparser
import fcntl
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

HOME = os.path.expanduser("~")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or HOME + "/.local/state", "appcolor")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or HOME + "/.cache", "appcolor")
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or HOME + "/.config", "appcolor")
PALETTE_JSON = os.path.join(STATE, "palette.json")
PALETTE_LUA = os.path.join(STATE, "palette.lua")
ENABLED = os.path.join(STATE, "enabled")
LOCK = os.path.join(STATE, "lock")
OVERRIDES = os.path.join(CONFIG, "overrides.json")
SETTINGS = os.path.join(CONFIG, "config.json")
PLUGIN_ID = "io.github.tuladhar.appcolor"
OMARCHY = os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy"
THEME_COLORS = HOME + "/.local/state/omarchy/current/theme/colors.toml"

DASHBOARD_URL = "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons@main/png/{}.png"
KEY_RE = re.compile(r"^[a-z0-9:._+-]{1,128}$")
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
HEX_RE = re.compile(r"^#?([0-9a-fA-F]{6})$")

# One solid colour per app, in three shades of the same hue so the border and
# title bar always match:
#   focused border    the brand colour, softened so it never glares
#   unfocused border  a dimmer shade, still clearly visible on dark wallpapers
#   title bar         a deep, muted shade the light title text reads on
ANGLE = 0
ACTIVE_LIGHTNESS = (0.52, 0.66)
ACTIVE_SATURATION = 0.72
INACTIVE_LIGHTNESS = 0.36
INACTIVE_SATURATION = 0.5
BAR_LIGHTNESS = 0.2
BAR_SATURATION = 0.42
MAX_STOPS = 4

DESKTOP_DIRS = [
    HOME + "/.local/share/applications",
    HOME + "/.local/share/flatpak/exports/share/applications",
    "/var/lib/flatpak/exports/share/applications",
    "/usr/local/share/applications",
    "/usr/share/applications",
]
ICON_BASES = [HOME + "/.local/share/icons", HOME + "/.icons", "/usr/local/share/icons", "/usr/share/icons"]
ICON_SIZES = ["scalable", "512x512", "256x256", "192x192", "128x128", "96x96", "64x64", "48x48"]
GENERIC_LABELS = {"www", "app", "apps", "web", "my", "mail", "m", "com", "org", "net", "io", "co", "so", "ai", "dev", "app"}


# --------------------------------------------------------------- palette

def load_palette():
    try:
        with open(PALETTE_JSON) as f:
            data = json.load(f)
        return {k: v for k, v in data.items() if KEY_RE.match(k) and isinstance(v, dict)}
    except (OSError, ValueError):
        return {}


def write_atomic(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def save_palette(palette):
    write_atomic(PALETTE_JSON, json.dumps(palette, indent=2, sort_keys=True) + "\n")
    lines = ["-- Generated by appcolor. Edit ~/.config/appcolor/overrides.json instead.", "return {"]

    def gradient(hexes):
        stops = ", ".join(f'"rgba({h}ff)"' for h in hexes)
        return f"{{ colors = {{ {stops} }}, angle = {ANGLE} }}"

    for key in sorted(palette):
        if not KEY_RE.match(key):
            continue
        border = palette[key].get("border")
        ok = (isinstance(border, dict)
              and all(isinstance(border.get(side), list) and border[side]
                      and all(isinstance(h, str) and re.fullmatch(r"[0-9a-f]{6}", h) for h in border[side])
                      for side in ("active", "inactive")))
        if ok:
            bar = border.get("bar")
            bar_lua = f', bar = "rgb({bar})"' if isinstance(bar, str) and re.fullmatch(r"[0-9a-f]{6}", bar) else ""
            lines.append(f'  ["{key}"] = {{ active = {gradient(border["active"])}, '
                         f'inactive = {gradient(border["inactive"])}{bar_lua} }},')
        else:
            lines.append(f'  ["{key}"] = false,')
    lines.append("}")
    write_atomic(PALETTE_LUA, "\n".join(lines) + "\n")


def load_overrides():
    try:
        with open(OVERRIDES) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    out = {}
    for key, colors in data.items() if isinstance(data, dict) else []:
        if not (isinstance(key, str) and KEY_RE.match(key) and isinstance(colors, list)):
            continue
        rgbs = [hex_to_rgb(c) for c in colors[:MAX_STOPS] if isinstance(c, str) and HEX_RE.match(c)]
        if rgbs:
            out[key] = rgbs
    return out


# --------------------------------------------------------------- colours

def hex_to_rgb(text):
    h = HEX_RE.match(text).group(1)
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


def rgb_to_hex(rgb):
    return "".join(f"{max(0, min(255, round(c * 255))):02x}" for c in rgb)


def read_pixels(path):
    """Opaque pixels of the icon, shrunk to 64x64, as (r, g, b) in 0..1."""
    cmd = ["magick", "-background", "none", path + "[0]", "-resize", "64x64",
           "-colorspace", "sRGB", "-type", "TrueColorAlpha", "-depth", "8", "txt:-"]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=15).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    pixels = []
    for m in re.finditer(r"#([0-9A-Fa-f]{6})([0-9A-Fa-f]{2})?\b", out):
        if m.group(2) is not None and int(m.group(2), 16) < 160:
            continue
        pixels.append(hex_to_rgb(m.group(1)))
    return pixels


def hue_distance(a, b):
    d = abs(a - b) % 1.0
    return min(d, 1.0 - d)


def tune(h, l, s):
    """Keep a stop vivid and readable as a thin border on dark or light walls."""
    return colorsys.hls_to_rgb(h % 1.0, min(max(l, 0.45), 0.68), max(s, 0.6))


def extract_stops(path):
    pixels = read_pixels(path)
    if not pixels:
        return None
    colourful = []
    for r, g, b in pixels:
        h, l, s = colorsys.rgb_to_hls(r, g, b)
        if s >= 0.25 and 0.12 <= l <= 0.92:
            colourful.append((h, l, s))

    # Black/white/grey icons (Notion, ChatGPT, OBS) have no brand colour;
    # the caller gives them the theme's accent colours instead.
    if len(colourful) < max(12, 0.03 * len(pixels)):
        return "mono"

    # Greedy hue clustering: take the busiest hue, gather everything within
    # 20deg of it, repeat while the next cluster holds at least 6% of pixels.
    remaining = colourful
    clusters = []
    while remaining and len(clusters) < MAX_STOPS:
        bins = [0] * 24
        for h, _, _ in remaining:
            bins[int(h * 24) % 24] += 1
        center = (max(range(24), key=lambda i: bins[i]) + 0.5) / 24
        members = [p for p in remaining if hue_distance(p[0], center) <= 20 / 360]
        if clusters and len(members) < 0.03 * len(colourful):
            break
        if not members:
            break
        remaining = [p for p in remaining if hue_distance(p[0], center) > 20 / 360]
        # Circular mean of hue, plain mean of lightness and saturation.
        sx = sum(math.cos(2 * math.pi * p[0]) for p in members)
        sy = sum(math.sin(2 * math.pi * p[0]) for p in members)
        hue = (math.atan2(sy, sx) / (2 * math.pi)) % 1.0
        light = sum(p[1] for p in members) / len(members)
        sat = sum(p[2] for p in members) / len(members)
        clusters.append((hue, light, sat, len(members)))

    # Most-used colour first; finalize() picks one for the app.
    return [tune(h, l, s) for h, l, s, _ in clusters]


def theme_stops():
    """Accent colours of the current Omarchy theme, for colourless icons."""
    colors = {}
    try:
        with open(THEME_COLORS) as f:
            for line in f:
                m = re.match(r'^\s*([\w]+)\s*=\s*"#([0-9a-fA-F]{6})"', line)
                if m:
                    colors[m.group(1)] = m.group(2)
    except OSError:
        pass
    picks = [colors[k] for k in ("accent", "cyan", "blue", "magenta", "green", "yellow", "orange", "red") if k in colors]
    unique = list(dict.fromkeys(h.lower() for h in picks))
    if len(unique) < 2:
        unique = ["8bcbb1", "96b7d0", "b7a1c8", "d2ab8d"]
    return [hex_to_rgb("#" + h) for h in unique]


def shade(rgb, lightness, max_saturation):
    h, _, sat = colorsys.rgb_to_hls(*rgb)
    return rgb_to_hex(colorsys.hls_to_rgb(h, lightness, min(sat, max_saturation)))


def border_value(rgb):
    """The three matching shades of one app colour."""
    h, l, sat = colorsys.rgb_to_hls(*rgb)
    lo, hi = ACTIVE_LIGHTNESS
    active = rgb_to_hex(colorsys.hls_to_rgb(h, min(max(l, lo), hi), min(sat, ACTIVE_SATURATION)))
    return {
        "active": [active],
        "inactive": [shade(rgb, INACTIVE_LIGHTNESS, INACTIVE_SATURATION)],
        "bar": shade(rgb, BAR_LIGHTNESS, BAR_SATURATION),
    }


# --------------------------------------------------------------- icons

def strip_profile(cls):
    m = re.match(r"^chrome-(.+)-(default|profile_\d+)$", cls.lower())
    return m.group(1) if m else None


def desktop_entries():
    seen = set()
    for d in DESKTOP_DIRS:
        for path in sorted(glob.glob(os.path.join(d, "*.desktop"))):
            name = os.path.basename(path)
            if name in seen:
                continue
            seen.add(name)
            parser = configparser.ConfigParser(interpolation=None, strict=False)
            parser.optionxform = str
            try:
                parser.read(path, encoding="utf-8")
                entry = parser["Desktop Entry"]
            except (configparser.Error, KeyError, UnicodeDecodeError, OSError):
                continue
            yield name[:-len(".desktop")], entry


def resolve_icon_name(name):
    if not name:
        return None
    if os.path.isabs(name):
        return name if os.path.isfile(name) else None
    themes = ["hicolor"]
    try:
        theme = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "icon-theme"],
                               capture_output=True, text=True, timeout=3).stdout.strip().strip("'")
        if theme and re.fullmatch(r"[\w.+-]+", theme):
            themes.append(theme)
    except (OSError, subprocess.TimeoutExpired):
        pass
    # hicolor first: it holds the app's own brand artwork, not a restyled one.
    for theme in themes:
        for base in ICON_BASES:
            for size in ICON_SIZES:
                for ext in ("svg", "png"):
                    p = os.path.join(base, theme, size, "apps", f"{name}.{ext}")
                    if os.path.isfile(p):
                        return p
    for ext in ("svg", "png", "xpm"):
        p = f"/usr/share/pixmaps/{name}.{ext}"
        if os.path.isfile(p):
            return p
    return None


def local_icon(key):
    if key == "claude":
        p = os.path.join(OMARCHY, "shell/plugins/agents/assets/claude.svg")
        return p if os.path.isfile(p) else None

    if key.startswith("web:"):
        stem = key[4:]
        for _, entry in desktop_entries():
            wm = entry.get("StartupWMClass", "")
            if wm and strip_profile(wm) == stem:
                icon = resolve_icon_name(entry.get("Icon", ""))
                if icon:
                    return icon
        return None

    # Best match first: the window class the entry declares, then its file
    # name, then its executable. Chrome's own web-app entries also run
    # google-chrome, so they only count after the real browser entry.
    ranked = []
    for name, entry in desktop_entries():
        wm = entry.get("StartupWMClass", "").lower()
        exe = os.path.basename((entry.get("Exec", "").split() or [""])[0]).lower()
        if key == wm:
            ranked.append((0, entry))
        elif key == name.lower():
            ranked.append((1, entry))
        elif key == exe and not name.lower().startswith(("chrome-", "msedge-", "brave-")):
            ranked.append((2, entry))
    for _, entry in sorted(ranked, key=lambda r: r[0]):
        icon = resolve_icon_name(entry.get("Icon", ""))
        if icon:
            return icon
    return resolve_icon_name(key)


def dashboard_slugs(key):
    if key == "claude":
        names = ["claude-ai", "claude", "anthropic"]
    elif key.startswith("web:"):
        host = key[4:].split("__")[0]
        labels = [l for l in host.split(".") if l]
        core = labels[-2] if len(labels) >= 2 else (labels[0] if labels else "")
        names = [core] + [l for l in labels[:-1] if l not in GENERIC_LABELS and l != core]
        names.append("-".join(labels[:-1]))
    else:
        parts = key.split(".")
        names = [key.replace(".", "-"), parts[-1], *reversed(parts[:-1])]
        names += [n.replace("_", "-") for n in names]
    out = []
    for n in names:
        n = n.lower()
        if SLUG_RE.match(n) and n not in out and n not in GENERIC_LABELS:
            out.append(n)
    return out[:5]


def downloads_allowed():
    try:
        with open(SETTINGS) as f:
            data = json.load(f)
        return not (isinstance(data, dict) and data.get("downloadIcons") is False)
    except (OSError, ValueError):
        return True


def download_icon(key):
    if not downloads_allowed():
        return None
    folder = os.path.join(CACHE, "icons")
    os.makedirs(folder, exist_ok=True)
    for slug in dashboard_slugs(key):
        dest = os.path.join(folder, slug + ".png")
        if os.path.isfile(dest):
            return dest
        tmp = dest + ".part"
        try:
            result = subprocess.run(
                ["curl", "-fsSL", "--proto", "=https", "--max-time", "10", "--max-filesize", "2000000",
                 "-o", tmp, DASHBOARD_URL.format(slug)],
                capture_output=True, timeout=20)
        except (OSError, subprocess.TimeoutExpired):
            continue
        try:
            with open(tmp, "rb") as f:
                is_png = f.read(8) == b"\x89PNG\r\n\x1a\n"
        except OSError:
            is_png = False
        if result.returncode == 0 and is_png:
            os.replace(tmp, dest)
            return dest
        try:
            os.remove(tmp)
        except OSError:
            pass
    return None


def resolve(key, overrides):
    """The app's own colours. finalize() picks one of them for the app."""
    if key in overrides:
        return {"source": "override", "brand": ["#" + rgb_to_hex(overrides[key][0])]}
    icon = local_icon(key)
    source = "local"
    if not icon:
        icon = download_icon(key)
        source = "dashboard-icons"
    stops = extract_stops(icon) if icon else None
    if stops == "mono":
        return {"source": "theme", "icon": icon, "brand": []}
    if not stops:
        return {"source": "none", "brand": []}
    return {"source": source, "icon": icon, "brand": ["#" + rgb_to_hex(c) for c in stops]}


# --------------------------------------------------------------- one colour per app

def finalize(palette):
    """Give every app one colour, its own, chosen so apps stay apart.

    A one-colour brand (HubSpot, Claude, YouTube) keeps its colour. A
    multi-colour logo (Chrome, Gmail, Firefox) takes whichever of its own
    colours sits furthest from the other apps, leaning toward its main one.
    A black-and-white icon takes the theme colour furthest from the others.
    """
    theme = theme_stops()
    options = {}
    for key in sorted(palette):
        entry = palette[key]
        brand = [hex_to_rgb(c) for c in entry.get("brand", []) if isinstance(c, str) and HEX_RE.match(c)]
        if brand:
            options[key] = brand
        elif entry.get("source") == "theme":
            options[key] = theme
        else:
            entry.pop("colors", None)
            entry["border"] = None
    choice = {key: 0 for key in options}

    def hue(key, i):
        return colorsys.rgb_to_hls(*options[key][i])[0]

    # Hill-climb on the closest clash: a change is kept when it widens the
    # smallest hue gap between any two apps (then the next smallest, and so
    # on), with a slight lean toward each logo's main colour. Picking one app
    # at a time against the rest can get stuck with two apps on one colour.
    def spread(ch):
        keys = list(ch)
        gaps = []
        for a in keys:
            ha = hue(a, ch[a])
            near = min((hue_distance(ha, hue(b, ch[b])) for b in keys if b != a), default=1.0)
            gaps.append(round(near - 0.002 * ch[a], 4))
        return sorted(gaps)

    current = spread(choice)
    for _ in range(50):
        best = None
        for key in options:
            for i in range(len(options[key])):
                if i == choice[key]:
                    continue
                trial = dict(choice, **{key: i})
                score = spread(trial)
                if score > current and (best is None or score > best[0]):
                    best = (score, key, i)
        if not best:
            break
        current, key, i = best
        choice[key] = i

    for key, colors in options.items():
        rgb = colors[choice[key]]
        palette[key]["border"] = border_value(rgb)
        palette[key]["colors"] = ["#" + palette[key]["border"]["active"][0]]
    return palette


# --------------------------------------------------------------- commands

def notify_hyprland():
    subprocess.run(["hyprctl", "eval", "if AppColor then AppColor.reload() end"],
                   capture_output=True, timeout=5)


def notify_bar():
    subprocess.run(["omarchy-shell", PLUGIN_ID, "refresh"], capture_output=True, timeout=5)


def require_magick():
    """Icons are read with ImageMagick, which Omarchy does not install itself."""
    if shutil.which("magick"):
        return True
    subprocess.run(["omarchy-notification-send", "-u", "normal", "-g", "󰏘",
                    "App colours need ImageMagick: omarchy pkg add imagemagick"],
                   capture_output=True, timeout=5)
    print("appcolor: ImageMagick is missing; install it with: omarchy pkg add imagemagick", file=sys.stderr)
    return False


def with_lock(fn):
    os.makedirs(STATE, exist_ok=True)
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return fn()


def cmd_resolve(keys, force=False):
    keys = [k for k in keys if KEY_RE.match(k)]

    def run():
        palette = load_palette()
        overrides = load_overrides()
        changed = False
        for key in keys:
            if force or key not in palette:
                palette[key] = resolve(key, overrides)
                changed = True
        if changed or not os.path.isfile(PALETTE_LUA):
            save_palette(finalize(palette))
        return changed

    if with_lock(run):
        notify_hyprland()


def set_enabled(on):
    os.makedirs(STATE, exist_ok=True)
    if on:
        open(ENABLED, "w").close()
    elif os.path.exists(ENABLED):
        os.remove(ENABLED)
    lua = "true" if on else "false"
    subprocess.run(["hyprctl", "eval", f"if AppColor then AppColor.set_enabled({lua}) end"],
                   capture_output=True, timeout=5)
    notify_bar()
    subprocess.run(["omarchy-notification-send", "-u", "low", "-g", "󰏘",
                    "App-coloured borders " + ("on" if on else "off")], capture_output=True, timeout=5)


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "toggle"
    if cmd == "toggle":
        set_enabled(not os.path.exists(ENABLED))
    elif cmd == "on":
        set_enabled(True)
    elif cmd == "off":
        set_enabled(False)
    elif cmd == "status":
        on = os.path.exists(ENABLED)
        print("on" if on else "off")
        return 0 if on else 1
    elif cmd == "resolve":
        if not require_magick():
            return 1
        cmd_resolve(argv[2:])
    elif cmd == "rebuild":
        if not require_magick():
            return 1
        cmd_resolve(list(load_palette().keys()) + argv[2:], force=True)
    elif cmd == "list":
        for key, entry in sorted(load_palette().items()):
            print(f"{key:40} {entry.get('source', ''):16} {' '.join(entry.get('colors', [])) or '-'}")
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
